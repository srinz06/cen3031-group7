generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user")
  attributes   Json     @default("{}") @db.JsonB
}